            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "List exercises, optionally filtered by search, muscle group, and last-updated time",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "exercises"
                ],
                "summary": "List exercises",
                "parameters": [
                    {
                        "type": "string",
